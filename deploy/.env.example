# Copy to deploy/.env (never commit it) and fill in.
# Operator token: a long random string. Generate one with:  openssl rand -hex 24
ARES3_TOKEN=
# Token of the Cloudflare Tunnel: Zero Trust -> Networks -> Tunnels -> your tunnel -> Configure (docs/deploy.md)
TUNNEL_TOKEN=
# Commands a visitor WITHOUT the token may send (the judges): take part in the response and try the scenarios menu (inject_event, stop_event, reset). Empty = watch only.
# Everything else (speed, pause, declare an emergency) needs the token.
ARES3_GUEST_COMMANDS=approve_action,reject_action,ack_step,inject_event,stop_event,reset
# The page allowed to open the socket from a browser
ARES3_ORIGIN=https://ares.daado.dev
